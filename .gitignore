# فایل‌های تولیدی Gradle نباید در Git ثبت شوند.
.gradle/
# خروجی build تمام ماژول‌ها نادیده گرفته می‌شود.
build/
# فایل local.properties معمولاً شامل مسیر محلی Android SDK است و نباید commit شود.
local.properties
# تنظیمات محلی Android Studio نادیده گرفته می‌شود.
.idea/
# فایل‌های سیستم macOS نادیده گرفته می‌شوند.
.DS_Store
# فایل‌های امضای خصوصی Android هرگز نباید وارد مخزن عمومی شوند.
*.jks
# Keystoreهای با پسوند keystore نیز نادیده گرفته می‌شوند.
*.keystore
# فایل‌های idsig حاصل از امضای APK نادیده گرفته می‌شوند.
*.idsig
